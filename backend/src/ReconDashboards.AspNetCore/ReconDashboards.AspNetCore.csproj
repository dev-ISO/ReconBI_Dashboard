<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>ASP.NET Core surface for ReconDashboards: controllers under a configurable route prefix, authorization policy slots, DI integration (AddReconDashboards).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- FrameworkReference only: no Microsoft.AspNetCore.* or Microsoft.OpenApi package refs,
         so host apps' CVE-pinned OpenApi versions are never perturbed. -->
