# Copy to .env for docker compose. Dev-only defaults; change for anything shared.
POSTGRES_PASSWORD=rcd_dev_password
# Must match the password in db/init/01-roles-and-dbs.sql (first-start seed).
CHART_READER_PASSWORD=chart_reader_password
# HMAC signing key for the demo JWTs (>= 64 chars).
DEMO_TOKEN_KEY=dev-only-demo-signing-key-at-least-64-characters-long-0123456789abcdef
